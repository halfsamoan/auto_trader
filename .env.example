# KIS Open API credentials. Copy to .env and fill manually.
# Never commit real API keys, account numbers, or tokens.
KIS_MODE=paper
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_FUTURES_ACCOUNT_NO=12345678
KIS_FUTURES_ACCOUNT_PRODUCT_CODE=03
KIS_FUTURES_CRCY_CD=TUS
# KIS overseas futures product codes must be verified manually before live probe/orderable checks.
KIS_FUTURES_MNQ_PRODUCT_CODE=
KIS_FUTURES_MES_PRODUCT_CODE=
