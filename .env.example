# KIS Open API credentials. Copy this file to .env and fill values locally.
# Never commit real API keys, app secrets, account numbers, tokens, or broker output.

KIS_MODE=paper
KIS_APP_KEY=replace_with_your_kis_app_key
KIS_APP_SECRET=replace_with_your_kis_app_secret

# Domestic-stock account placeholders.
KIS_ACCOUNT_NO=00000000
KIS_ACCOUNT_PRODUCT_CODE=01

# Overseas-futures account placeholders. Confirm the product code with KIS.
KIS_FUTURES_ACCOUNT_NO=00000000
KIS_FUTURES_ACCOUNT_PRODUCT_CODE=03
KIS_FUTURES_CRCY_CD=TUS

# KIS overseas futures product codes must be manually verified before live probes.
KIS_FUTURES_MNQ_PRODUCT_CODE=
KIS_FUTURES_MES_PRODUCT_CODE=
